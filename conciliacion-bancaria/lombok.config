# Lombok configuration — raíz del módulo backend
# stopBubbling evita que Lombok busque config en directorios padre
config.stopBubbling = true

# Marca el código generado con @lombok.Generated para que JaCoCo
# lo excluya automáticamente del reporte de cobertura.
# Sin esta línea, los getters/builders/with* cuentan como líneas no cubiertas.
lombok.addLombokGeneratedAnnotation = true
